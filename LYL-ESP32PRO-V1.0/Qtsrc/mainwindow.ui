   <property name="styleSheet">
    <string>QWidget#centralWidget { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1e1e1e, stop:1 #2d2d2d); }

/* 通用GroupBox样式 */
QGroupBox { 
    border: 1px solid #404040; 
    border-radius: 8px; 
    margin-top: 15px; 
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2a2a2a, stop:1 #353535);
    border: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3a3a3a, stop:1 #454545);
}

QGroupBox::title { 
    subcontrol-origin: margin; 
    left: 10px; 
    padding: 0 8px 0 8px; 
    background-color: #333333; 
    color: #ffffff; 
    font-weight: bold;
    font-size: 13px;
    border-radius: 4px;
    border: 1px solid #606060;
}

/* 嵌套GroupBox样式 */
QGroupBox QGroupBox {
    border: 1px solid #454545;
    border-radius: 6px;
    margin-top: 12px;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #252525, stop:1 #303030);
    border: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #303030, stop:1 #3a3a3a);
}

QGroupBox QGroupBox::title {
    font-size: 12px;
    color: #ffffff;
    padding: 0 6px 0 6px;
    background-color: #3a3a3a;
}

/* 按钮样式 */
QPushButton {
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    color: white;
    border: none;
    background-color: #0078d7;
    outline: none;
}

QPushButton:hover {
    background-color: #1089ff;
    border: 1px solid rgba(0, 120, 215, 0.5);
}

QPushButton:pressed {
    background-color: #0066c0;
    border: 1px solid rgba(0, 120, 215, 0.3);
}

/* 按钮特定颜色 */
QPushButton#queryButton { background-color: #0078d7; }
QPushButton#queryButton:hover { background-color: #1089ff; border: 1px solid rgba(0, 120, 215, 0.5); }
QPushButton#queryHistoryButton { background-color: #107c10; }
QPushButton#queryHistoryButton:hover { background-color: #148c14; border: 1px solid rgba(16, 124, 16, 0.5); }
QPushButton#exportButton { background-color: #005a9e; }
QPushButton#exportButton:hover { background-color: #0066b3; border: 1px solid rgba(0, 90, 158, 0.5); }
QPushButton#refreshButton { background-color: #ffb900; color: #333333; }
QPushButton#refreshButton:hover { background-color: #ffc600; border: 1px solid rgba(255, 185, 0, 0.5); }
QPushButton#clearButton { background-color: #d13438; }
QPushButton#clearButton:hover { background-color: #e24549; border: 1px solid rgba(209, 52, 56, 0.5); }
QPushButton#openFanButton { background-color: #1a9c1a; color: #ffffff; }
QPushButton#openFanButton:hover { background-color: #1eaf1e; border: 1px solid rgba(26, 156, 26, 0.5); }
QPushButton#closeFanButton { background-color: #e14448; color: #ffffff; }
QPushButton#closeFanButton:hover { background-color: #f25559; border: 1px solid rgba(225, 68, 72, 0.5); }
QPushButton#openLightButton { background-color: #ffc900; color: #ffffff; }
QPushButton#openLightButton:hover { background-color: #ffda00; border: 1px solid rgba(255, 201, 0, 0.5); }
QPushButton#closeLightButton { background-color: #777777; color: #ffffff; }
QPushButton#closeLightButton:hover { background-color: #888888; border: 1px solid rgba(119, 119, 119, 0.5); }

/* 文本框样式 */
QLineEdit, QTextEdit {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3a3a3a, stop:1 #404040);
    border: 1px solid #505050;
    border-radius: 6px;
    padding: 8px 10px;
    color: #e0e0e0;
    font-size: 13px;
}

QLineEdit:focus, QTextEdit:focus {
    border-color: #0096ff;
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
}

/* 标签样式 */
QLabel {
    color: #cccccc;
    font-size: 13px;
}

QLabel#temperatureLabel {
    color: #33adff;
    font-size: 24px;
    font-weight: bold;
    background-color: rgba(51, 173, 255, 0.1);
    border: 1px solid rgba(51, 173, 255, 0.3);
    border-radius: 8px;
}

QLabel#humidityLabel {
    color: #4cd964;
    font-size: 24px;
    font-weight: bold;
    background-color: rgba(76, 217, 100, 0.1);
    border: 1px solid rgba(76, 217, 100, 0.3);
    border-radius: 8px;
}

QLabel#concentrationLabel {
    color: #ff8555;
    font-size: 24px;
    font-weight: bold;
    background-color: rgba(255, 133, 85, 0.1);
    border: 1px solid rgba(255, 133, 85, 0.3);
    border-radius: 8px;
}

/* 滑块样式 */
QSlider::groove:horizontal {
    border: 1px solid #404040;
    height: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #404040, stop:1 #505050);
    margin: 2px 0;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1a88ff, stop:1 #0066cc);
    border: 1px solid #0055aa;
    width: 20px;
    margin: -6px 0;
    border-radius: 10px;
    border-style: outset;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3399ff, stop:1 #1a75ff);
    border: 2px solid #0055aa;
    border-style: inset;
}

/* 进度条样式 */
QProgressBar#temperatureProgressBar {
    border: 1px solid #404040;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #404040, stop:1 #505050);
    text-align: center;
}

QProgressBar#temperatureProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #33adff, stop:1 #1a75ff);
    border-radius: 4px;
}

QProgressBar#humidityProgressBar {
    border: 1px solid #404040;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #404040, stop:1 #505050);
    text-align: center;
}

QProgressBar#humidityProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4cd964, stop:1 #2ea043);
    border-radius: 4px;
}

QProgressBar#concentrationProgressBar {
    border: 1px solid #404040;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #404040, stop:1 #505050);
    text-align: center;
}

QProgressBar#concentrationProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ff8555, stop:1 #e56600);
    border-radius: 4px;
}

/* 状态栏样式 */
QStatusBar {
    background-color: #333333;
    border-top: 1px solid #505050;
    color: #cccccc;
}

/* 菜单栏样式 */
QMenuBar {
    background-color: #333333;
    border-bottom: 1px solid #505050;
    color: #cccccc;
}

QMenuBar::item {
    background-color: transparent;
    color: #cccccc;
    padding: 8px 12px;
}

QMenuBar::item:selected {
    background-color: #454545;
    color: #ffffff;
}
